= form_with(model: merchant) do |form|
  - if merchant.errors.any?
    div style="color: red"
      h2 = "#{pluralize(merchant.errors.count, "error")} prohibited this merchant from being saved:"
      ul
        - merchant.errors.each do |error|
          li = error.full_message

  div.form-group.m-2
    = form.label :name, style: "display: block"
    = form.text_field :name, { class: "form-control" }

  div.form-group.m-2
    = form.label :description, style: "display: block"
    = form.textarea :description, { class: "form-control" }

  div.form-group.m-2
    = form.label :email, style: "display: block"
    = form.text_field :email, { class: "form-control" }

  div.form-group.m-2
    = form.label :status
    = form.select :status, Merchant.statuses.keys.map { |status| [status.titleize, status] }, { prompt: "Select a status..." }, { class: "form-control" }

  div.form-group.m-2
    = form.label :total_transaction_sum, style: "display: block"
    = form.number_field :total_transaction_sum, { class: "form-control" }

  div.m-2
    = form.submit
