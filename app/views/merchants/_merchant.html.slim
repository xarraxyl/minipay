div id="#{dom_id merchant}"
  h1 = merchant.name
  p
    strong Name:
    =< merchant.name
  p
    strong Description:
    =< merchant.description
  p
    strong Email:
    =< merchant.email
  p
    strong Status:
    =< merchant.status
  p
    strong Total transaction sum:
    =< merchant.total_transaction_sum
